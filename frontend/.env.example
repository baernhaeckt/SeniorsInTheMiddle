# --- Telemetry stream -------------------------------------------------------
# WebSocket endpoint of the proxy telemetry stream.
# Leave empty to run the built-in demo feed instead.
VITE_PROXY_WS_URL=ws://localhost:5080/stream

# --- Proxy address, as shown in the setup guide -----------------------------
# What people type into a device's proxy settings.
VITE_PROXY_HOST=proxy.sitm.local
VITE_PROXY_PORT=8888

# The Wi-Fi that already routes through the proxy, so a device needs no setup.
VITE_PROXY_NETWORK=SITM-Guest

# Optional. Derived from host and port when left empty.
VITE_PROXY_CA_URL=
VITE_PROXY_PAC_URL=
