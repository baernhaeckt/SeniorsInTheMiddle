# Copy to .env. Every value here has a working default in docker-compose.yml; this file
# exists so the knobs are discoverable without reading the compose file.

# ---- what to build ---------------------------------------------------------------
# Reuse an image you already have instead of building backend/Dockerfile again.
#PROXY_IMAGE=sitm-proxy:eval
#PROXY_LOG_LEVEL=Information

# The proxy will not start without a key: the JwtBearer registration builds a
# SymmetricSecurityKey over it, and appsettings.json ships it empty on purpose.
#JWT_KEY=aGFybmVzcy1vbmx5LWtleS1ub3QtYS1zZWNyZXQtMDAwMQ==

# ---- how the corpus is sent ------------------------------------------------------
# https goes out as CONNECT and is intercepted; http goes out in absolute form.
#EVAL_SCHEME=https
# Whether the connection to the proxy itself is TLS -- the :3127 listener a browser
# would be pointed at as a "secure proxy".
#EVAL_PROXY_TLS=false
# Documents in flight at once. The proxy's stand-in map is per client and per host, so
# there is nothing to prove by pushing this up.
#EVAL_CONCURRENCY=2
# A pause between documents, for watching a run happen rather than seeing it finish.
#EVAL_DELAY_MS=0

# ---- running it as a CI step -----------------------------------------------------
# Send the corpus once as soon as the proxy answers, without waiting for the button.
#EVAL_ON_START=true
# ... and then exit: 0 when nothing leaked, nothing failed and everything came back,
# non-zero otherwise. Pair with `docker compose up --abort-on-container-exit`.
#EVAL_EXIT_AFTER_RUN=true

# How long to wait for the proxy to answer /ca.crt before giving up on the run. A first
# build of backend/Dockerfile can take a while.
#STARTUP_TIMEOUT_MS=180000

# ---- the receiver's capture store ------------------------------------------------
# Request bodies are held in memory until a run releases them. These caps are what
# happens when a run dies before it can.
#EVAL_MAX_BODIES=2000
#EVAL_MAX_BYTES=134217728

# ---- scoring ---------------------------------------------------------------------
# Which kinds must be hidden, which must survive, which are only counted. Defaults live
# in evaluator/src/groundtruth.js; policy.json overrides them.
#POLICY_FILE=/policy.json
