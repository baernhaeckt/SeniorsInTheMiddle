<Window x:Class="DemoBrowser.Views.CertificateInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Connection security"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="640"
        Height="560"
        MinWidth="520"
        MinHeight="420"
        WindowStyle="None"
        Background="{StaticResource ChromeBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,14,6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Value}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ChainItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource ChromeGradient}">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderGlyph" Text="🔒" Foreground="{StaticResource TextBrush}" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderHost" Text="Connection security" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="44" IsCancel="True"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <!-- Summary card -->
        <Border Grid.Row="1" Margin="20,16,20,0" CornerRadius="10" Padding="14,12" x:Name="SummaryCard" Background="#14FFFFFF">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" x:Name="SummaryBadge" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock x:Name="SummaryGlyph" Text="🔒" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryTitle" Text="Connection is secure" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="SummaryDetail" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Details: chain on the left, selected certificate on the right -->
        <Grid Grid.Row="2" Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="CONNECTION" />
                <Border DockPanel.Dock="Top" Background="#0DFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Key}" Text="Protocol" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" x:Name="ProtocolText" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Key}" Text="Key exchange" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="KeyExchangeText" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Key}" Text="Cipher" Margin="0,0,14,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="CipherText" Margin="0" />
                    </Grid>
                </Border>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="CERTIFICATE CHAIN" />
                <ListBox x:Name="ChainList" Background="#0DFFFFFF" BorderThickness="0" ItemContainerStyle="{StaticResource ChainItem}"
                         SelectionChanged="OnChainSelectionChanged" Padding="4">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="2" Background="#0DFFFFFF" CornerRadius="8" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="CERTIFICATE" />
                        <TextBlock x:Name="NoCertText" Style="{StaticResource Value}" Foreground="{StaticResource TextMutedBrush}"
                                   Text="No certificate is available for this page." />
                        <Grid x:Name="CertGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Key}" Text="Subject" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" x:Name="SubjectText" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Key}" Text="Issuer" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="IssuerText" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Key}" Text="Alt. names" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="SanText" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Key}" Text="Valid from" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" x:Name="ValidFromText" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Key}" Text="Valid to" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" x:Name="ValidToText" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Key}" Text="Public key" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" x:Name="KeyText" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Key}" Text="Signature" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" x:Name="SignatureText" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Key}" Text="Serial" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Mono}" x:Name="SerialText" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Key}" Text="SHA-256" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Mono}" x:Name="FingerprintText" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="20,14,20,18">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Copy PEM" Click="OnCopyPemClick" x:Name="CopyButton" />
            <Button Style="{StaticResource PrimaryButton}" Content="Close" Width="90" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
