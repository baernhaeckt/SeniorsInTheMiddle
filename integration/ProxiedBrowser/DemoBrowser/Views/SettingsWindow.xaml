<Window x:Class="DemoBrowser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource ChromeBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,10" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource PillTextBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource ChromeGradient}">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="⚙" Foreground="{StaticResource TextBrush}" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="Settings" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="44" IsCancel="True"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <Grid Grid.Row="1" Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="PROXY" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Scheme" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SchemeBox" HorizontalAlignment="Left" Width="120">
                <ComboBoxItem Content="http" />
                <ComboBoxItem Content="https" />
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Host" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="HostBox" />

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Port" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="PortBox" HorizontalAlignment="Left" Width="120" />

            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="Bypass list" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="BypassBox"
                     ToolTip="Chromium --proxy-bypass-list syntax, e.g. localhost;*.corp.example.com. Leave empty for none." />

            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}" Text="CA certificate URL" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="CaUrlBox" />

            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Label}" Text="Start page" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="StartPageBox" />

            <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Background="#14FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,4,0,16">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           Text="Proxy and CA settings are read once when the browser engine starts. Changes take effect after restarting the application." />
            </Border>

            <DockPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Reset to defaults" Click="OnResetClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="90" IsDefault="True" Click="OnSaveClick" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
