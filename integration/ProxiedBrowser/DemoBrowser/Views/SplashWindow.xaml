<Window x:Class="DemoBrowser.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demo Browser"
        Width="460"
        Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Shield pulse, rotating halo, drifting gradient and a sweeping progress bar -->
        <Storyboard x:Key="Intro" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HaloRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6" />
            <DoubleAnimation Storyboard.TargetName="HaloRotate2" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:9" />
            <DoubleAnimation Storyboard.TargetName="ShieldScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.06" Duration="0:0:1.4" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShieldScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.06" Duration="0:0:1.4" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:1.4" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="X" From="-160" To="420" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <PointAnimation Storyboard.TargetName="BgGradient" Storyboard.TargetProperty="StartPoint" From="0,0" To="1,0" Duration="0:0:5" AutoReverse="True" />
            <PointAnimation Storyboard.TargetName="BgGradient" Storyboard.TargetProperty="EndPoint" From="1,1" To="0,1" Duration="0:0:5" AutoReverse="True" />
        </Storyboard>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="0.94" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="0.94" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.3" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="18" Margin="16" RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush x:Name="BgGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0D1216" Offset="0" />
                <GradientStop Color="#FF0C2A2B" Offset="0.55" />
                <GradientStop Color="#FF225851" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Emblem -->
            <Grid Grid.Row="0" Width="150" Height="150" Margin="0,24,0,0">
                <!-- Outer glow -->
                <Ellipse x:Name="Glow" Width="140" Height="140" Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66288879" Offset="0" />
                            <GradientStop Color="#0038B5EE" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Rotating dashed halos -->
                <Ellipse Width="130" Height="130" StrokeThickness="1.5" StrokeDashArray="6 10" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF288879" Offset="0" />
                            <GradientStop Color="#FF38B5EE" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="HaloRotate" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="108" Height="108" StrokeThickness="1" StrokeDashArray="2 6" Opacity="0.45" Stroke="#FF8A3D56" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="HaloRotate2" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Shield (same geometry as the frontend icon) -->
                <Viewbox Width="64" Height="64" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <ScaleTransform x:Name="ShieldScale" />
                    </Viewbox.RenderTransform>
                    <Canvas Width="32" Height="32">
                        <Path Data="{StaticResource ShieldGeometry}" Fill="{StaticResource ShieldFillBrush}"
                              Stroke="{StaticResource ShieldStrokeBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                        <Path Data="{StaticResource ShieldRightGeometry}" Fill="#FF38B5EE" Opacity="0.18" />
                        <Rectangle Canvas.Left="11" Canvas.Top="14" Width="10" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ShieldBarBrush}" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Wordmark + status -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Seniors in the Middle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="PII PROXY BROWSER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock.LayoutTransform><ScaleTransform ScaleX="1.08" /></TextBlock.LayoutTransform>
                </TextBlock>
                <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>

            <!-- Sweeping progress line -->
            <Border Grid.Row="2" Height="3" Margin="28,16,28,22" CornerRadius="2" Background="#22FFFFFF" ClipToBounds="True">
                <Rectangle Width="160" HorizontalAlignment="Left" RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00288879" Offset="0" />
                            <GradientStop Color="#FF288879" Offset="0.5" />
                            <GradientStop Color="#FF38B5EE" Offset="0.8" />
                            <GradientStop Color="#0038B5EE" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="Sweep" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
    </Border>
</Window>
