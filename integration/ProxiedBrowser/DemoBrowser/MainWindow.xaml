<Window x:Class="DemoBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:DemoBrowser.ViewModels"
        Title="Demo Browser"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStyle="None"
        Background="{StaticResource ChromeBrush}"
        WindowStartupLocation="CenterScreen">

    <!-- Custom chrome: the OS title bar is removed and the tab strip becomes the draggable caption area. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="TabHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="MaxWidth" Value="200" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" />
                            <Border x:Name="Accent" Height="2" VerticalAlignment="Top" Margin="10,0" CornerRadius="1"
                                    Background="{StaticResource AccentGradient}" Opacity="0" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ToolbarBrush}" />
                                <Setter TargetName="Accent" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="4,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="ChromeIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource ChromeBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: title bar = app badge + tab strip + caption buttons (all WebView2s are elsewhere, see WebViewHost) -->
            <Grid Grid.Row="0" Background="{StaticResource ChromeGradient}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,8,0" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="32" Height="32">
                            <Path Data="{StaticResource ShieldGeometry}" Fill="{StaticResource ShieldFillBrush}"
                                  Stroke="{StaticResource ShieldStrokeBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                            <Path Data="{StaticResource ShieldRightGeometry}" Fill="#FF38B5EE" Opacity="0.18" />
                            <Rectangle Canvas.Left="11" Canvas.Top="14" Width="10" Height="4" RadiusX="1" RadiusY="1" Fill="{StaticResource ShieldBarBrush}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Demo Browser" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" FontSize="12"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tabs + new tab button -->
                <DockPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChromeIconButton}" Content="+" ToolTip="New tab (Ctrl+T)"
                            Width="30" Height="30" Margin="4,0,0,4" Command="{Binding NewTabCommand}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                    <Button Style="{StaticResource TabHeaderButton}"
                                            Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Source}">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}" Content="✕" ToolTip="Close tab"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimizeClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="OnMaximizeClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnCloseClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- Row 1: navigation toolbar -->
            <Border Grid.Row="1" Background="{StaticResource ToolbarBrush}" Padding="8,6">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="←" ToolTip="Back" Command="{Binding BackCommand}" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="→" ToolTip="Forward" Command="{Binding ForwardCommand}" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" ToolTip="Reload / Stop" Command="{Binding ReloadOrStopCommand}">
                        <TextBlock x:Name="ReloadStopGlyph" Text="↻" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⚙" ToolTip="Settings" Click="OnSettingsClick" />
                    <Grid Margin="8,0">
                        <TextBox x:Name="AddressBar" Style="{StaticResource PillTextBox}" Padding="30,5,12,5"
                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnAddressBarKeyDown" GotKeyboardFocus="OnAddressBarGotFocus" />
                        <TextBlock Text="🔒" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Row 2: non-blocking warning banner -->
            <Border Grid.Row="2" Background="#FF4A3A12" BorderBrush="#FFB58A1E" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕" ToolTip="Dismiss" Command="{Binding DismissWarningCommand}" />
                    <TextBlock Text="⚠" DockPanel.Dock="Left" Foreground="#FFF2C14E" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FFF7E3A6" />
                </DockPanel>
            </Border>

            <!-- Row 3: all WebView2 instances live here simultaneously; only Visibility toggles on tab switch. -->
            <Grid x:Name="WebViewHost" Grid.Row="3" Background="White" />
        </Grid>
    </Border>
</Window>
