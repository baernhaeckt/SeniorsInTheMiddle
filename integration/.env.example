# Copy to .env. Compose reads it automatically from this directory.
# Everything here has a default in docker-compose.yml; the file exists so the knobs are
# discoverable without reading the compose file.

# Run against a pre-built image instead of building backend/Dockerfile locally, e.g.
# ghcr.io/baernhaeckt/seniorsinthemiddle-backend:latest. Leave unset to build.
# PROXY_IMAGE=

# Any non-empty value works: this is a throwaway harness, not a deployment.
JWT_KEY=aGFybmVzcy1vbmx5LWtleS1ub3QtYS1zZWNyZXQtMDAwMQ==

# Set to Debug to see every forwarded request; Information already logs the decrypted
# tunnel chunks from StreamProxy, which is usually what you want to look at.
PROXY_LOG_LEVEL=Information

# Traffic shape. All four are editable live in the testing UI on http://localhost:3100.
RATE_PER_MINUTE=120
CONCURRENCY=4
HTTPS_RATIO=0.5
PII_RATIO=0.35

# Same seed, same sequence of scenarios and fixtures.
SEED=20260822

# One-shot mode: send this many requests, print a summary, exit non-zero if the success
# rate falls below MIN_SUCCESS_RATE. 0 keeps the sender running.
BURST=0
MIN_SUCCESS_RATE=0.95

# How long the sender waits for the proxy to answer /ca.crt before giving up. It exits
# non-zero and compose restarts it, rather than hanging forever on a proxy that is broken.
STARTUP_TIMEOUT_MS=120000
