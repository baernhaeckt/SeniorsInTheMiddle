{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // The SPA runs in its own container on its own origin. Every origin the dashboard is
    // served from has to be listed here, without a trailing slash.
    "AllowedOrigins": [
      "https://seniorsinthemiddle-frontend.icymushroom-561b0fa4.northeurope.azurecontainerapps.io"
    ]
  },
  "Proxy": {
    // What a device is configured to point at, and the first entry in the PAC file.
    "HttpPort": 3128,
    // The same proxy inside TLS, using a certificate signed by our own CA. Set to 0 where
    // no client speaks TLS to the proxy.
    "HttpsPort": 3127,
    // The WebAPI, Swagger and the telemetry stream. Never proxies.
    "ApiPort": 8080,
    // Extra names this deployment is reached by, added to the certificate.
    "HostNames": [],
    // Destinations left unintercepted: no MITM certificate, no decryption, no rewrite. A CONNECT
    // to one of these is tunnelled byte for byte, so the origin sees the client's own TLS
    // handshake. An entry covers its subdomains too.
    //
    // This is for bot management, not privacy, and it costs the inspection entirely: a host
    // listed here has nothing detected in what a device sends it and nothing restored in what
    // comes back. Turnstile is here because it is the challenge itself rather than a site
    // carrying one, and it never receives anything a user typed.
    //
    // Note what is deliberately absent. Sites behind a challenge stay intercepted; the challenge
    // under their /cdn-cgi/ path is excluded from rewriting instead, which leaves their chat
    // traffic readable -- see ForwardProxyTransformer.IsBotManagement.
    "BypassHosts": [ "challenges.cloudflare.com" ],
    // Largest body held in memory so it can be rewritten, requests and responses alike, and
    // measured after decompression. Anything above it streams through untouched and the skip is
    // logged. Held per concurrent exchange, so it multiplies by however many devices are talking
    // at once; 0 forwards every body as it arrived.
    "MaxMutableBodyBytes": 1048576
  },
  "Jwt": {
    "Key": "", // Overwritten in production by Env variable
    "Issuer": "Backend",
    "Audience": "BackendApp"
  },
  "Services": {
    // The python services this process talks to, one unix socket each. An empty path
    // disables the service (the normal state on a Windows dev box). The container image
    // sets Services__<Name>__SocketPath in step with the supervisord program that opens it.
    "Pii": {
      "SocketPath": "",
      "ConnectTimeoutSeconds": 30
    },
    "PrivacyCheck": {
      "SocketPath": "",
      "ConnectTimeoutSeconds": 60
    }
  },
  "Auth": {
    // Accounts live in memory and are gone on every restart and every new revision, so one
    // is recreated at startup. Without it a restarted container has nobody who can sign in,
    // and the public demo would be a login screen with no way past it.
    //
    // This password is in a public repository and is meant to be: it opens a proof-of-concept
    // carrying synthetic traffic, nothing else. Before this deployment ever sees a real
    // household, replace it via Auth__SeedUser__Password and turn Advertise off.
    "SeedUser": {
      "Username": "demo",
      "Email": "demo@sitm.local",
      "Password": "demo",
      // Serves the seeded credentials at GET /api/v1/auth/demo-account so the login screen
      // prefills them and a visitor only has to press Sign in. On this deployment that hides
      // nothing anyway -- the password is three lines up, in the same public file -- so
      // leaving it off would add friction for a juror without denying anything to anyone.
      // Set Auth__SeedUser__Advertise=false to take the endpoint dark without a redeploy.
      "Advertise": true
    }
  }
}
