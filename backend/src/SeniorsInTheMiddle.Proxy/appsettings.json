{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // The SPA runs in its own container on its own origin. Every origin the dashboard is
    // served from has to be listed here, without a trailing slash.
    "AllowedOrigins": [
      "https://seniorsinthemiddle-frontend.greensea-158b1300.northeurope.azurecontainerapps.io"
    ]
  },
  "Proxy": {
    // What a device is configured to point at. Also the port the PAC file advertises.
    "HttpPort": 8080,
    // The API over TLS, using a certificate signed by our own CA. Set to 0 where the
    // host terminates TLS itself.
    "HttpsPort": 8443,
    // Extra names this deployment is reached by, added to the certificate.
    "HostNames": []
  },
  "Jwt": {
    "Key": "", // Overwritten in production by Env variable
    "Issuer": "Backend",
    "Audience": "BackendApp"
  }
}
