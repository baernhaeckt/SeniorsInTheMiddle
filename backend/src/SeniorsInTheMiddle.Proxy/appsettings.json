{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // The SPA runs in its own container on its own origin. Every origin the dashboard is
    // served from has to be listed here, without a trailing slash.
    "AllowedOrigins": [
      "https://seniorsinthemiddle-frontend.greensea-158b1300.northeurope.azurecontainerapps.io"
    ]
  },
  "Proxy": {
    // What a device is configured to point at, and the first entry in the PAC file.
    "HttpPort": 3128,
    // The same proxy inside TLS, using a certificate signed by our own CA. Set to 0 where
    // no client speaks TLS to the proxy.
    "HttpsPort": 3127,
    // The WebAPI, Swagger and the telemetry stream. Never proxies.
    "ApiPort": 8080,
    // Extra names this deployment is reached by, added to the certificate.
    "HostNames": []
  },
  "Jwt": {
    "Key": "", // Overwritten in production by Env variable
    "Issuer": "Backend",
    "Audience": "BackendApp"
  },
  "Services": {
    // The python services this process talks to, one unix socket each. An empty path
    // disables the service (the normal state on a Windows dev box). The container image
    // sets Services__Pii__SocketPath in step with the supervisord program that opens it.
    "Pii": {
      "SocketPath": "",
      "ConnectTimeoutSeconds": 30
    }
  }
}
